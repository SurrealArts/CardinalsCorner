# Copy this file to backend/.env for local development:
#   cp .env.example backend/.env
# (backend/.env is the live config; this file is only a template.)
PORT=3040
# Relative file: URLs resolve to backend/prisma/dev.db for both the app and migrations.
DATABASE_URL="file:./dev.db"
JWT_SECRET="dev-only-change-me"
SYNC_API_KEYS="dev-sync-key-1"
TZ="Asia/Manila"
VITE_API_URL="http://localhost:3040/api"
