# Copy this file to backend/.env for local development:
#   cp .env.example backend/.env
# (backend/.env is the live config; this file is only a template.)
PORT=3040
# Prisma resolves relative file: URLs against the directory containing
# schema.prisma (backend/prisma/), NOT the working directory — so this means
# backend/prisma/dev.db for both `migrate` and the app. Absolute file:/... or
# libsql:// URLs pass through unchanged (e.g. file:/data/....db in containers).
DATABASE_URL="file:./dev.db"
JWT_SECRET="dev-only-change-me"
SYNC_API_KEYS="dev-sync-key-1"
# First admin on an empty database (used at first boot when no users exist):
# ADMIN_EMAIL="admin@mapua.edu.ph"
# ADMIN_PASSWORD="change-me-immediately"
TZ="Asia/Manila"
VITE_API_URL="http://localhost:3040/api"
