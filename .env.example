# Copy this file to backend/.env for local development:
#   cp .env.example backend/.env
# (backend/.env is the live config; this file is only a template.)
PORT=3040

# Prisma resolves relative file: URLs against the directory containing
# schema.prisma (backend/prisma/), NOT the working directory — so this means
# backend/prisma/dev.db for both `db push` and the app. Absolute file:/...
# URLs pass through unchanged (e.g. file:/data/....db in containers).
DATABASE_URL="file:./dev.db"

# Signs login tokens. Any value works locally; production refuses to boot with
# fewer than 32 characters — generate one with: openssl rand -hex 32
JWT_SECRET="dev-only-change-me"

# Sessions: idle sign-out (minutes of inactivity) and hard session cap (hours).
IDLE_TIMEOUT_MIN="30"
SESSION_MAX_H="12"

# Extra origins allowed cookie-authenticated API access (dev server default).
CORS_ORIGINS="http://localhost:5173"

# First admin on an empty database (used at first boot when no users exist,
# and by `db:seed`). Leave commented to use the seed's demo credentials.
# ADMIN_EMAIL="admin@mapua.edu.ph"
# ADMIN_PASSWORD="change-me-immediately"

TZ="Asia/Manila"
VITE_API_URL="http://localhost:3040/api"

# Leave NODE_ENV unset (or development) locally: production mode enables
# Secure cookies, which plain-HTTP localhost cannot receive.
# NODE_ENV="development"
