generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Single invisible admin account. No public registration, no requester roles.
enum Role {
  ADMIN
  STAFF
  STUDENT
}

enum RoomStatus {
  ACTIVE
  ARCHIVED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique // university email
  role         Role     @default(STUDENT)
  department   String?
  passwordHash String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  activityLogs          ActivityLog[]
  sessions              Session[]
}

model Room {
  id          String     @id @default(cuid())
  code        String     @unique // e.g. SW305, AV-1, Smart Classroom 1
  campus      String     @default("Intramuros")
  wing        String // S, SW, W, N, NW, NB, SB, AV, SMART, OTHER
  openMin     Int        @default(480) // operating hours, minutes since midnight (07:00)
  closeMin    Int        @default(1260) // 21:00
  status      RoomStatus @default(ACTIVE)
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  classSchedules ClassSchedule[]
  closures       Closure[]
}

model Term {
  id        String   @id @default(cuid())
  name      String   @unique // NT-YYYY-ZZZZ, e.g. 1T-2026-2027
  startDate DateTime
  endDate   DateTime
  // Class-period grid for display + linting. The university changes this per
  // era (50, 70, presently 90 minutes); each term pins its own so old
  // schedules keep rendering exactly as entered.
  periodMin   Int @default(90)
  dayStartMin Int @default(450) // first period starts 07:30
  dayEndMin   Int @default(1260) // last period ends 21:00
  createdAt DateTime @default(now())

  classSchedules ClassSchedule[]
}

model ClassSchedule {
  id        String @id @default(cuid())
  roomId    String
  termId    String
  course    String // course code, e.g. ECEA101
  section   String // class section, e.g. A1, B14, E05
  professor String // instructor name
  weekday   Int // 0=Sunday .. 6=Saturday (Mon=1 typical)
  startMin  Int // minutes since midnight (sanitized: 07:00 earliest)
  endMin    Int // minutes since midnight (sanitized: 21:00 latest)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  term Term @relation(fields: [termId], references: [id], onDelete: Cascade)

  @@index([roomId, termId, weekday])
}

model Closure {
  id        String   @id @default(cuid())
  roomId    String
  date      String // YYYY-MM-DD (Philippine local time)
  startMin  Int? // null = whole day
  endMin    Int?
  reason    String
  createdAt DateTime @default(now())

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, date])
}

model ActivityLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String // e.g. schedule.create, schedule.import, room.create
  entityType String // room | schedule | closure | user | term
  entityId  String?
  detail    String? // JSON string
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
}

// Server-side session allowlist: every issued token carries its row id (jti).
// Logout, password change, deactivation, or admin revocation marks the row, so
// stolen/copied tokens stop working instead of living until JWT expiry.
model Session {
  id         String    @id // jti from the token
  userId     String
  userAgent  String?
  ip         String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
